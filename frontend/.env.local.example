# Base URL of the Go backend API. Local default points at the compose service.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Lab console, linked from the navbar for admins only. The Lab is private
# infrastructure on the owner's tailnet: the name resolves publicly but answers
# nowhere else. Unset means no navbar entry, which is what a build that is not
# the owner's wants.
# NEXT_PUBLIC_LAB_CONSOLE_URL=https://console.lab.aliflabs.dev
